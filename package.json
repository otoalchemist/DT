{
  "name": "death-and-taxes-bot",
  "version": "1.13.0",
  "private": true,
  "description": "Self-hosted automation bot for the DeathAndTaxes on-chain game (defense + game-strategy, Flashbots inclusion).",
  "license": "MIT",
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/web"
  ],
  "scripts": {
    "build:shared": "npm run build -w @dat-bot/shared",
    "dev:backend": "npm run dev -w @dat-bot/backend",
    "dev:web": "npm run dev -w @dat-bot/web",
    "dev": "npm run build:shared && concurrently --kill-others-on-fail -n backend,web -c blue,magenta \"npm:dev:backend\" \"npm:dev:web\"",
    "build": "npm run build:shared && npm run build -w @dat-bot/backend && npm run build -w @dat-bot/web",
    "start": "npm run build:shared && node packages/backend/dist/main.js",
    "test": "npm run test -w @dat-bot/backend",
    "package": "node scripts/package.mjs",
    "update": "node scripts/update.mjs",
    "update:check": "node scripts/update.mjs --check",
    "rival-skippers": "node scripts/rival-skippers.mjs",
    "rival-builder-bids": "node scripts/rival-builder-bids.mjs",
    "target-scores": "node scripts/target-scores.mjs",
    "race-timing": "node scripts/race-timing.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
