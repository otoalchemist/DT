# --- Death & Taxes Bot config ---
# Copy this file to `.env` and fill in your values. NEVER commit your real .env.

# "mainnet" = live game via Flashbots (frontrun protection, slightly slower).
# "public"  = live game via public mempool (fastest, no frontrun protection).
# "local"   = anvil fork, broadcasts directly.
MODE=mainnet

# Easiest: one Alchemy key derives HTTP, WSS, and NFT API endpoints.
ALCHEMY_API_KEY=

# ...or set endpoints explicitly (override the derived ones). Any RPC works.
# RPC_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/your-key
# RPC_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/your-key
# ALCHEMY_NFT_URL=https://eth-mainnet.g.alchemy.com/nft/v3/your-key

# Local API (dashboard talks to this). Keep it bound to localhost.
HOST=127.0.0.1
PORT=8787

# Optional overrides
# GAME_ADDRESS=0xa448c7f618087dDa1a3B128cAd8A424fBae4B71F
# FLASHBOTS_RELAY_URL=https://relay.flashbots.net

# Builders that receive your bundle (mainnet mode). Only the builder that wins a
# slot can include it, so the bot submits to all of these in parallel and succeeds
# if any accepts. Defaults to the list below (Flashbots, BuilderNet, beaverbuild,
# Titan) — all verified live and accept eth_sendBundle with an X-Flashbots-Signature
# header. Endpoints do change; verify against each builder's docs before relying on
# them. (rsync-builder.xyz was dropped — unreachable as of 2026-07.)
# BUILDER_URLS=https://relay.flashbots.net,https://rpc.buildernet.org,https://rpc.beaverbuild.org,https://rpc.titanbuilder.xyz
# MAX_CANDIDATES=500
# LOG_LEVEL=info

# Startup auto-update of the curated default lists (rival targets/skippers, allies,
# do-not-target) from the repo's master branch, so a roster change reaches you without
# re-downloading the bot. Default "on". A git checkout is skipped automatically (use
# git there) and a list you edited yourself is never overwritten.
#   off   = never fetch; only the lists in your data/ folder are used
#   force = sync even in a git checkout (for testing the sync itself)
# LIST_AUTO_UPDATE=on

# For local/anvil testing only: skip the NFT API by hardcoding token ids.
# OWNED_TOKENS=123,456
# TARGET_TOKENS=789,1011
