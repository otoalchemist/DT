# --- Death & Taxes Bot config ---
# Copy this file to `.env` and fill in your values. NEVER commit your real .env.

# "mainnet" = private bundles to configured builders plus a public payment fallback.
# "public"  = public mempool only (no bundle privacy or direct builder route).
# "local"   = anvil fork, broadcasts directly.
# Leave unset for the mainnet default and dashboard-persisted mode changes. If set
# here, mode is environment-owned and read-only in the dashboard until restart.
# MODE=mainnet

# Easiest: one Alchemy key derives HTTP, WSS, and NFT API endpoints. If filled
# here it is environment-owned; replace it here and restart, not in the dashboard.
ALCHEMY_API_KEY=

# ...or set endpoints explicitly (override the derived ones). An explicit HTTP
# endpoint never inherits a derived mainnet websocket.
# RPC_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/your-key
# RPC_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/your-key
# ALCHEMY_NFT_URL=https://eth-mainnet.g.alchemy.com/nft/v3/your-key

# Local API (dashboard talks to this). Only 127.0.0.1, localhost, and ::1 are
# accepted; startup fails rather than exposing the unlocked wallet API to a LAN.
HOST=127.0.0.1
PORT=8787
# Dev dashboard proxy target. Defaults to http://127.0.0.1:<PORT>.
# BACKEND_URL=http://127.0.0.1:8787

# Per-instance durable state. Use a different directory outside this checkout for
# every bot process; custom paths are not covered by this repository's .gitignore.
# DATA_DIR=/absolute/path/to/death-and-taxes-data

# Optional overrides
# GAME_ADDRESS=0xa448c7f618087dDa1a3B128cAd8A424fBae4B71F
# FLASHBOTS_RELAY_URL=https://relay.flashbots.net

# Builders that receive your bundle (mainnet mode). Only the builder that wins a
# slot can include it, so the bot submits to all of these in parallel and succeeds
# if any accepts. Defaults to the list below (Flashbots, BuilderNet, beaverbuild,
# Titan) — all provider-documented for eth_sendBundle as of 2026-07. Authentication
# requirements differ; the bot supplies an X-Flashbots-Signature header, which the
# listed endpoints accept or ignore. Endpoints do change, so verify each provider's
# current docs before relying on them. (rsync-builder.xyz was dropped after it was
# unreachable during the 2026-07 release review.)
# BUILDER_URLS=https://relay.flashbots.net,https://rpc.buildernet.org,https://rpc.beaverbuild.org,https://rpc.titanbuilder.xyz
# MAX_CANDIDATES=500
# LOG_LEVEL=info

# For local/anvil testing only: skip the NFT API by hardcoding token ids.
# OWNED_TOKENS=123,456
# TARGET_TOKENS=789,1011
